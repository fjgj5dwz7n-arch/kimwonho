{
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/works", "destination": "/cv", "permanent": true },
    { "source": "/works/:slug", "destination": "/cv", "permanent": true },
    { "source": "/archive", "destination": "/cv", "permanent": true },
    { "source": "/archive/:slug", "destination": "/cv", "permanent": true }
  ]
}
