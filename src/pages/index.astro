---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveItems } from "../data/archive";
import { researchProjects } from "../data/research";
import { site } from "../data/site";
---

<BaseLayout title={site.title}>
  <section class="home-hero section">
    <img
      class="hero-photo"
      src="/assets/cover-photo.jpeg"
      alt="전시장 안에서 큰 회화 앞에 선 김원호"
    />
    <div class="home-copy">
      <p class="eyebrow">Kim Wonho</p>
      <h1>현대시를 공부하는 학생</h1>
      <p class="lede">
        시를 쓰고 읽으며, 현대시의 문장과 장면을 오래 들여다봅니다.
        이곳에는 작품, 연구 관심, 발표 이력과 문학 활동의 기록을 차분히 정리합니다.
      </p>
      <div class="hero-links" aria-label="주요 바로가기">
        <a href="/works/">작품·기록</a>
        <a href="/research/">연구</a>
        <a href="/cv/">이력</a>
      </div>
    </div>
  </section>

  <section class="section two-column">
    <div>
      <p class="eyebrow">Current Focus</p>
      <h2>최근 연구 관심</h2>
    </div>
    <div class="stack">
      {
        researchProjects.slice(0, 2).map((project) => (
          <article class="text-block">
            <p class="small-caps">{project.period} · {project.status}</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Works & Records</p>
      <h2>최근 작품과 기록</h2>
      <a href="/works/">전체 보기</a>
    </div>
    <div class="archive-strip archive-strip-single">
      <ol>
      {
        archiveItems.slice(0, 5).map((item) => (
          <li>
            <time datetime={item.date}>{item.date}</time>
            <span>{item.type}</span>
            {item.href ? <a href={item.href}><strong>{item.title}</strong></a> : <strong>{item.title}</strong>}
          </li>
        ))
      }
      </ol>
    </div>
  </section>
</BaseLayout>
