---
import BaseLayout from "../layouts/BaseLayout.astro";
import content from "../data/content.json";
import { cvSections } from "../data/cv";
import { site, siteAssets } from "../data/site";
---

<BaseLayout title={site.title}>
  <section class="home-hero section">
    <img
      class="hero-photo"
      src={siteAssets.coverImage}
      alt={content.home.coverAlt}
    />
    <div class="home-copy">
      <p class="eyebrow">{content.home.eyebrow}</p>
      <h1>{content.home.headline}</h1>
      <p class="lede">{content.home.lede}</p>
      <div class="hero-links" aria-label="주요 바로가기">
        <a href="/cv/">이력</a>
        <a href="/research/">연구</a>
        <a href="/contact/">연락</a>
      </div>
    </div>
  </section>

  <section class="section cv-wrap home-cv">
    {
      cvSections.map((section) => (
        <article class="cv-section">
          <div>
            <p class="eyebrow">Curriculum Vitae</p>
            <h2>{section.title}</h2>
          </div>
          <ol>
            {section.items.map((item) => (
              <li>
                <time datetime={item.year}>{item.year}</time>
                <div>
                  <h3>
                    {
                      item.href ? (
                        <a
                          href={item.href}
                          target={item.href.startsWith("http") ? "_blank" : undefined}
                          rel={item.href.startsWith("http") ? "noreferrer" : undefined}
                        >
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )
                    }
                  </h3>
                  {item.organization && <p class="muted">{item.organization}</p>}
                  {item.detail && <p>{item.detail}</p>}
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </section>
</BaseLayout>
