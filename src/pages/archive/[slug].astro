---
import PageIntro from "../../components/PageIntro.astro";
import { tistoryArchive, type TistoryArchiveEntry } from "../../data/tistoryArchive";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return tistoryArchive.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: TistoryArchiveEntry };
---

<BaseLayout title={item.title} description={item.summary}>
  <PageIntro
    eyebrow={`${item.type} · ${item.date.slice(0, 10)}`}
    title={item.title}
    description={item.summary}
  />

  <article class="section archive-detail">
    <div class="archive-detail-meta">
      <p class="small-caps">Source</p>
      <a href={item.sourceUrl} target="_blank" rel="noreferrer">티스토리 원문</a>
      <p class="small-caps">Materials</p>
      <p>이미지 {item.images.length}개 · 링크 {item.links.length}개</p>
    </div>

    <div class="archive-detail-body">
      {item.body.length > 0 && (
        <section class="archive-copy">
          {item.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      )}

      {item.links.length > 0 && (
        <section class="archive-links">
          <h2>링크</h2>
          <ul>
            {item.links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {item.images.length > 0 && (
        <section class="archive-images">
          <h2>이미지</h2>
          <div class="archive-image-grid">
            {item.images.map((image) => (
              <figure>
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  width={image.width}
                  height={image.height}
                />
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
