---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { tistoryArchive } from "../data/tistoryArchive";
---

<BaseLayout title="작품과 기록">
  <PageIntro
    eyebrow="Works & Records"
    title="작품과 기록"
    description="시, 희곡, 산문, 게재, 수상, 입주와 인터뷰 기록을 한 흐름 안에서 정리합니다."
  />

  <section class="section archive-index">
    {
      tistoryArchive.map((item) => (
        <article class="archive-entry">
          <a href={`/works/${item.slug}/`} aria-label={`${item.title} 상세 보기`}>
            {item.images[0] && (
              <img src={item.images[0].src} alt="" loading="lazy" />
            )}
            <div>
              <p class="small-caps">{item.date.slice(0, 10)} · {item.type}</p>
              <h2>{item.title}</h2>
              <p>{item.summary}</p>
              <p class="archive-counts">
                이미지 {item.images.length}개
                {item.links.length > 0 && ` · 링크 ${item.links.length}개`}
              </p>
            </div>
          </a>
        </article>
      ))
    }
  </section>
</BaseLayout>
