---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import content from "../data/content.json";
import { site, siteAssets } from "../data/site";
---

<BaseLayout title="소개">
  <PageIntro
    eyebrow={content.about.eyebrow}
    title={content.about.title}
    description={content.about.description}
  />

  <section class="section prose-grid">
    <aside>
      <figure class="profile-portrait">
        <img src={siteAssets.profileImage} alt={content.about.profileAlt} />
      </figure>
      <p class="small-caps">Based in {site.location}</p>
      <p>{site.role}</p>
    </aside>
    <div class="prose">
      {content.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</BaseLayout>
